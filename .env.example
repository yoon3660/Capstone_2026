# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env

# 무공해차 통합누리집(환경부) 충전소 정보 API 키  (T-05)
EVDT_MOE_API_KEY=

# 한국도로공사 공공데이터 API 키 (교통량 / VDS 속도)  (T-07, T-08)
EVDT_EX_API_KEY=

# SQLite 마스터 DB 경로 (비워두면 프로젝트 루트의 evdt.db)
EVDT_DB_PATH=
